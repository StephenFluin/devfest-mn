rules_version = '2';

// Storage rules can't read the Realtime Database, so admins are marked with an `admin: true`
// custom claim instead. Set it with scripts/set-admin-claim.mjs.
service firebase.storage {
  match /b/{bucket}/o {
    // Everything in the bucket is public site content.
    match /{allPaths=**} {
      allow read: if true;
    }

    // Speaker headshots, uploaded from the speaker editor.
    match /{year}/speakers/{speakerId}/{filename} {
      allow create, update: if request.auth.token.admin == true
        && year.matches('devfest[0-9]{4}')
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(png|jpeg|webp)');
      allow delete: if request.auth.token.admin == true;
    }
  }
}
