{
  "rules": {
    "admin": {
      ".read": "root.child('admin/'+auth.uid).exists()",
      "$user_id": {
        ".read": "$user_id === auth.uid",
        ".write": "($user_id === auth.uid && newData.exists() && auth.token.email_verified === true && root.child('adminEmails/' + auth.token.email.toLowerCase().replace('.', ',')).exists()) || (root.child('admin/'+auth.uid).exists() && $user_id !== auth.uid && !newData.exists())",
        ".validate": "!newData.exists() || newData.child('email').val() === auth.token.email"
      }
    },
    "adminEmails": {
      ".read": "root.child('admin/'+auth.uid).exists()",
      "$email_key": {
        ".read": "auth.token.email_verified === true && auth.token.email.toLowerCase().replace('.', ',') === $email_key",
        ".write": "root.child('admin/'+auth.uid).exists()",
        ".validate": "newData.hasChildren(['email', 'addedAt']) && newData.child('email').isString() && newData.child('email').val().toLowerCase().replace('.', ',') === $email_key",
        "email": { ".validate": "newData.isString() && newData.val().length <= 254" },
        "name": { ".validate": "newData.isString() && newData.val().length <= 100" },
        "addedBy": { ".validate": "newData.isString() && newData.val().length <= 254" },
        "addedAt": { ".validate": "newData.val() === now || newData.isNumber()" },
        "$other": { ".validate": false }
      }
    },
    "burndown": {
      ".read": "root.child('admin/'+auth.uid).exists()",
      ".write": "root.child('admin/'+auth.uid).exists()"
    },
    "analytics": {
      ".read": "root.child('admin/'+auth.uid).exists()",
      ".write": false
    },
    "marketing": {
      "$year": {
        "links": {
          ".read": true,
          ".write": "$year.matches(/^[0-9]{4}$/) && root.child('admin/'+auth.uid).exists()",
          "$slug": {
            ".validate": "$slug.matches(/^[a-z0-9][a-z0-9-]{1,39}$/) && newData.hasChildren(['source', 'medium', 'campaign', 'landing'])",
            "source": {
              ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 50"
            },
            "medium": {
              ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 50"
            },
            "campaign": {
              ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 80"
            },
            "landing": {
              ".validate": "newData.isString() && newData.val().matches(/^\\/[^ ]{0,200}$/)"
            },
            "promo": {
              ".validate": "newData.isString() && newData.val().matches(/^[A-Za-z0-9_-]{2,30}$/)"
            },
            "$other": { ".validate": false }
          }
        },
        "campaigns": {
          ".read": "root.child('admin/'+auth.uid).exists()",
          ".write": "$year.matches(/^[0-9]{4}$/) && root.child('admin/'+auth.uid).exists()"
        }
      }
    },
    "users": {
      "$user_id": {
        ".read": "$user_id === auth.uid",
        ".write": "$user_id === auth.uid"
      }
    },
    "$year": {
      "schedule": {
        ".read": true,
        ".indexOn": "title",
        "$session_id": {
          ".write": "$year.matches(/^devfest[0-9]{4}$/) && (root.child('admin/'+auth.uid).exists() || root.child($year+'/volunteers/'+auth.uid).exists())"
        }
      },
      "speakers": {
        ".read": true,
        ".indexOn": "name",
        ".write": "$year.matches(/^devfest[0-9]{4}$/) && root.child('admin/'+auth.uid).exists()",
        "$speaker_id": {
          ".write": "$year.matches(/^devfest[0-9]{4}$/) && data.exists() && newData.exists() && root.child($year+'/speakerGrants/'+auth.uid+'/speaker').val() === $speaker_id",
          "published": {
            ".validate": "root.child('admin/'+auth.uid).exists() || newData.val() === data.val()"
          }
        }
      },
      "speakerInvites": {
        ".read": "root.child('admin/'+auth.uid).exists()",
        ".write": "$year.matches(/^devfest[0-9]{4}$/) && root.child('admin/'+auth.uid).exists()",
        ".indexOn": "speaker",
        "$token": {
          ".read": true
        }
      },
      "speakerGrants": {
        "$user_id": {
          ".read": "$user_id === auth.uid",
          ".write": "$year.matches(/^devfest[0-9]{4}$/) && $user_id === auth.uid",
          ".validate": "newData.hasChildren(['token', 'speaker']) && newData.child('token').isString() && newData.child('token').val().matches(/^[A-Za-z0-9_-]{20,}$/) && root.child($year+'/speakerInvites/'+newData.child('token').val()+'/speaker').val() === newData.child('speaker').val()"
        }
      },
      "editLog": {
        ".read": "root.child('admin/'+auth.uid).exists()",
        ".indexOn": "key",
        "$entry": {
          ".write": "$year.matches(/^devfest[0-9]{4}$/) && auth != null && !data.exists() && newData.exists()",
          ".validate": "newData.hasChildren(['at', 'path', 'key', 'action', 'via', 'uid']) && newData.child('uid').val() === auth.uid && ((newData.child('via').val() === 'admin' && root.child('admin/'+auth.uid).exists() && newData.child('email').val() === auth.token.email && !newData.child('speaker').exists()) || (newData.child('via').val() === 'invite' && newData.child('action').val() === 'update' && newData.child('speaker').isString() && root.child($year+'/speakerGrants/'+auth.uid+'/speaker').val() === newData.child('speaker').val() && (newData.child('path').val() === 'schedule' || newData.child('key').val() === newData.child('speaker').val())))",
          "at": { ".validate": "newData.val() === now" },
          "path": { ".validate": "newData.val() === 'speakers' || newData.val() === 'schedule'" },
          "key": {
            ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 64"
          },
          "label": { ".validate": "newData.isString() && newData.val().length <= 200" },
          "action": {
            ".validate": "newData.val() === 'create' || newData.val() === 'update' || newData.val() === 'delete'"
          },
          "via": { ".validate": "newData.val() === 'admin' || newData.val() === 'invite'" },
          "uid": { ".validate": "newData.isString()" },
          "email": { ".validate": "newData.isString() && newData.val() === auth.token.email" },
          "name": { ".validate": "newData.isString() && newData.val().length <= 100" },
          "speaker": { ".validate": "newData.isString() && newData.val().length <= 64" },
          "changes": {
            "$field": {
              ".validate": "$field.length <= 40",
              "from": {
                ".validate": "newData.isBoolean() || newData.isNumber() || newData.hasChildren() || (newData.isString() && newData.val().length <= 6100)",
                "$item": { ".validate": "newData.isString() && newData.val().length <= 64" }
              },
              "to": {
                ".validate": "newData.isBoolean() || newData.isNumber() || newData.hasChildren() || (newData.isString() && newData.val().length <= 6100)",
                "$item": { ".validate": "newData.isString() && newData.val().length <= 64" }
              },
              "$other": { ".validate": false }
            }
          },
          "$other": { ".validate": false }
        }
      },
      "rooms": {
        ".read": true,
        ".indexOn": "order",
        ".write": "$year.matches(/^devfest[0-9]{4}$/) && root.child('admin/'+auth.uid).exists()",
        "$room_id": {
          ".validate": "newData.hasChildren(['name'])",
          "name": {
            ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 80"
          },
          "directions": {
            ".validate": "newData.isString() && newData.val().length <= 500"
          },
          "order": {
            ".validate": "newData.isNumber()"
          },
          "$other": {
            ".validate": false
          }
        }
      },
      "agendas": {
        "$user_id": {
          ".read": "$user_id === auth.uid",
          ".write": "$year.matches(/^devfest[0-9]{4}$/) && $user_id === auth.uid",
          "$session_id": {
            ".validate": "newData.hasChildren(['value']) && root.child($year+'/schedule/'+$session_id).exists()",
            "value": {
              ".validate": "newData.isBoolean()"
            },
            "$other": {
              ".validate": false
            }
          }
        }
      },
      "feedback": {
        ".read": "root.child('admin/'+auth.uid).exists()",
        "$user_id": {
          ".read": "$user_id === auth.uid",
          ".write": "$year.matches(/^devfest[0-9]{4}$/) && $user_id === auth.uid",
          "$session_id": {
            ".validate": "newData.hasChildren() && root.child($year+'/schedule/'+$session_id).exists()",
            "speaker": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 5"
            },
            "content": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 5"
            },
            "recommendation": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 5"
            },
            "comment": {
              ".validate": "newData.isString() && newData.val().length < 2000"
            },
            "$other": {
              ".validate": false
            }
          }
        }
      },
      "volunteers": {
        ".read": "root.child('admin/'+auth.uid).exists()",
        ".write": "$year.matches(/^devfest[0-9]{4}$/) && root.child('admin/'+auth.uid).exists()",
        "$user_id": {
          ".read": "$user_id === auth.uid",
          ".write": "$year.matches(/^devfest[0-9]{4}$/) && $user_id === auth.uid && newData.exists() && auth.token.email_verified === true && root.child($year + '/volunteerEmails/' + auth.token.email.toLowerCase().replace('.', ',')).exists()",
          ".validate": "!newData.exists() || root.child('admin/'+auth.uid).exists() || newData.child('email').val() === auth.token.email"
        }
      },
      "volunteerEmails": {
        ".read": "root.child('admin/'+auth.uid).exists()",
        "$email_key": {
          ".read": "auth.token.email_verified === true && auth.token.email.toLowerCase().replace('.', ',') === $email_key",
          ".write": "$year.matches(/^devfest[0-9]{4}$/) && root.child('admin/'+auth.uid).exists()",
          ".validate": "newData.hasChildren(['email', 'addedAt']) && newData.child('email').isString() && newData.child('email').val().toLowerCase().replace('.', ',') === $email_key",
          "email": { ".validate": "newData.isString() && newData.val().length <= 254" },
          "name": { ".validate": "newData.isString() && newData.val().length <= 100" },
          "addedBy": { ".validate": "newData.isString() && newData.val().length <= 254" },
          "addedAt": { ".validate": "newData.val() === now || newData.isNumber()" },
          "$other": { ".validate": false }
        }
      },
      "adminNotes": {
        ".read": "root.child('admin/'+auth.uid).exists()",
        ".write": "$year.matches(/^devfest[0-9]{4}$/) && root.child('admin/'+auth.uid).exists()"
      }
    }
  }
}
