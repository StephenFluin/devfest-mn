{
    "rules": {
        "admin": {
            ".read": "root.child('admin/'+auth.uid).exists()",
            "$user_id": {
                ".read": "$user_id === auth.uid"
            }
        },
        "burndown": {
            ".read": "root.child('admin/'+auth.uid).exists()",
            ".write": "root.child('admin/'+auth.uid).exists()"
        },
        "users": {
            "$user_id": {
                ".read": "$user_id === auth.uid",
                ".write": "$user_id === auth.uid"
            }
        },
        "$year": {
            "schedule": {
                ".read": true,
                ".indexOn": "title",
                "$session_id": {
                    ".write": "$year.matches(/^devfest[0-9]{4}$/) && (root.child('admin/'+auth.uid).exists() || root.child($year+'/volunteers/'+auth.uid).exists())"
                }
            },
            "speakers": {
                ".read": true,
                ".indexOn": "name",
                ".write": "$year.matches(/^devfest[0-9]{4}$/) && root.child('admin/'+auth.uid).exists()"
            },
            "agendas": {
                "$user_id": {
                    ".read": "$user_id === auth.uid",
                    ".write": "$year.matches(/^devfest[0-9]{4}$/) && $user_id === auth.uid",
                    "$session_id": {
                        ".validate": "newData.hasChildren(['value']) && root.child($year+'/schedule/'+$session_id).exists()",
                        "value": {
                            ".validate": "newData.isBoolean()"
                        },
                        "$other": {
                            ".validate": false
                        }
                    }
                }
            },
            "feedback": {
                ".read": "root.child('admin/'+auth.uid).exists()",
                "$user_id": {
                    ".read": "$user_id === auth.uid",
                    ".write": "$year.matches(/^devfest[0-9]{4}$/) && $user_id === auth.uid",
                    "$session_id": {
                        ".validate": "newData.hasChildren() && root.child($year+'/schedule/'+$session_id).exists()",
                        "speaker": {
                            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 5"
                        },
                        "content": {
                            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 5"
                        },
                        "recommendation": {
                            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 5"
                        },
                        "comment": {
                            ".validate": "newData.isString() && newData.val().length < 2000"
                        },
                        "$other": {
                            ".validate": false
                        }
                    }
                }
            },
            "volunteers": {
                ".read": "root.child('admin/'+auth.uid).exists()",
                ".write": "$year.matches(/^devfest[0-9]{4}$/) && root.child('admin/'+auth.uid).exists()"
            },
            "adminNotes": {
                ".read": "root.child('admin/'+auth.uid).exists()",
                ".write": "$year.matches(/^devfest[0-9]{4}$/) && root.child('admin/'+auth.uid).exists()"
            }
        }
    }
}
